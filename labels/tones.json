{
 "version": 2,
 "note": "Tone-of-voice taxonomy for EmoJet. Canonical labels are what the model outputs; aliases are synonyms from the source lists (used to map datasets and docs). Emoji rows are priors that steer suggestions toward the tone the writer is using. Sources: owner's brief (4 communication styles + 16 tones), Nielsen Norman Group 'Tone-of-Voice Words' (37 words, 4 dimensions), PapersOwl 'Types of Tone' (~85), Grammarly tone detector (40+). v2 (2026-10-05): owner's master taxonomy - 8 behavioral styles, 2 contextual axes, 19 more tones incl. the rare/pathological ones; synonyms merged as aliases.",
 "styles": {
  "question": "Which communication style is my message?",
  "options": {
   "assertive": {
    "desc": "balanced, direct, respects boundaries",
    "example": "I understand your point, but I need us to meet this deadline first."
   },
   "passive": {
    "desc": "submissive, compliant, self-sacrificing",
    "example": "Whatever everyone else wants to do is fine with me."
   },
   "aggressive": {
    "desc": "dominant, hostile, violates boundaries",
    "example": "You need to stop doing it that way because it's wrong."
   },
   "passive-aggressive": {
    "desc": "subtly resistant, indirectly hostile",
    "example": "Fine, I'll do it your way, since you always know best."
   },
   "manipulative": {
    "desc": "uses guilt or deception to control outcomes",
    "example": "After everything I've done for you, you can't even do this one thing?"
   },
   "collaborative": {
    "desc": "cooperative, looks for a win-win",
    "example": "What if you take the slides and I do the demo, then we review together?"
   },
   "transactional": {
    "desc": "purely functional, quid pro quo",
    "example": "Send the invoice and I'll transfer the money today."
   },
   "avoidant": {
    "desc": "evasive, stonewalling, withdraws",
    "example": "Can we not talk about this right now."
   }
  }
 },
 "dimensions": {
  "note": "Sliders as 0..1 scores (first word = 0): Nielsen Norman Group's four tone dimensions + the owner's two cultural/contextual axes.",
  "funny_serious": [
   "funny",
   "serious"
  ],
  "formal_casual": [
   "formal",
   "casual"
  ],
  "respectful_irreverent": [
   "respectful",
   "irreverent"
  ],
  "enthusiastic_matter_of_fact": [
   "enthusiastic",
   "matter-of-fact"
  ],
  "high_low_context": [
   "high-context (implicit, read between the lines)",
   "low-context (explicit, literal)"
  ],
  "linear_circular": [
   "linear (structured, one topic)",
   "circular (narrative, digressive)"
  ]
 },
