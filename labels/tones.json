    "tentative":     { "family": "formal", "aliases": ["hesitant", "unsure", "uncertain"], "emojis": ["🤔", "😅", "😬", "🫣", "🤷", "😶"] },
    "urgent":        { "family": "formal", "aliases": ["pressing", "alarmed"], "emojis": ["⚠️", "❗", "⏰", "🆘", "🏃", "‼️"] },

    "sad":           { "family": "vulnerable", "aliases": ["melancholic", "down", "heartbroken"], "emojis": ["😢", "😭", "😔", "💔", "🥺", "😞"] },
